<Window x:Class="DynamicIslandApp.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="600"
        Height="250"
        Left="0"
        Top="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Button Style for Media Controls -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="20" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seekbar Slider Style -->
        <Style x:Key="IslandSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#A0A0B0" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#303038" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="10" Height="10" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#555555"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{x:Null}">
        <!-- Center container -->
        <Border x:Name="PillBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#08080C"
                BorderBrush="#252530"
                BorderThickness="1"
                ClipToBounds="True"
                Width="180"
                Height="32"
                CornerRadius="0,0,16,16"
                SizeChanged="PillBorder_SizeChanged"
                MouseEnter="PillBorder_MouseEnter"
                MouseLeave="PillBorder_MouseLeave"
                MouseLeftButtonUp="PillBorder_MouseLeftButtonUp"
                MouseRightButtonUp="PillBorder_MouseRightButtonUp">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- 1. COMPACT IDLE VIEW (Clock + Dot) -->
                <Grid x:Name="CompactIdleView" Visibility="Visible" Opacity="1" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Cyan / Green status dot -->
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#4ade80" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#4ade80" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Digital Clock -->
                    <TextBlock x:Name="CompactClockText" Grid.Column="2" Text="18:46"
                               Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI, SF Pro Display, Arial"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 2. EXPANDED IDLE VIEW (Big Clock + Date + No media + Quick icons) -->
                <Grid x:Name="ExpandedIdleView" Visibility="Collapsed" Opacity="0" Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top row: Quick action icons -->
                    <Grid Grid.Row="0">
                        <!-- Volume Icon -->
                        <Button HorizontalAlignment="Left" Style="{StaticResource MediaButtonStyle}" Padding="4" Click="VolumeBtn_Click" ToolTip="Âm lượng / Tắt tiếng">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#B0B0C0"
                                  Data="M3,9v6h4l5,5V4L7,9H3z M16.5,12c0-1.77-1.02-3.29-2.5-4.03v8.05C15.48,15.29,16.5,13.77,16.5,12z M14,3.23v2.06c2.89,0.86,5,3.54,5,6.71s-2.11,5.85-5,6.71v2.06c4.01-0.91,7-4.49,7-8.77S18.01,4.14,14,3.23z"/>
                        </Button>
                        
                        <!-- Search Icon -->
                        <Button HorizontalAlignment="Right" Style="{StaticResource MediaButtonStyle}" Padding="4" Click="SearchBtn_Click" ToolTip="Tìm kiếm Windows">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#B0B0C0"
                                  Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </Button>
                    </Grid>

                    <!-- Center: Big Clock & Date -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,4">
                        <TextBlock x:Name="ExpandedClockText" Text="18:46"
                                   Foreground="#FFFFFF" FontSize="32" FontWeight="Bold"
                                   FontFamily="Segoe UI, SF Pro Display, Arial"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ExpandedDateText" Text="Sunday, September 13"
                                   Foreground="#8E8E9E" FontSize="12" FontWeight="Normal"
                                   FontFamily="Segoe UI, Arial"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Bottom: No media playing status -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#3b82f6" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#3b82f6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="No media playing" Foreground="#6E6E80" FontSize="11" FontFamily="Segoe UI, Arial"/>
                    </StackPanel>
                </Grid>

                <!-- 3. COMPACT MEDIA VIEW (Thumbnail + Song title marquee + Equalizer bars) -->
                <Grid x:Name="CompactMediaView" Visibility="Collapsed" Opacity="0" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Album Thumbnail -->
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Image x:Name="CompactAlbumArt" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Marquee Song Title -->
                    <TextBlock x:Name="CompactTitleText" Grid.Column="1"
                               Text="tiếng Chuông Bát Nhã Lofi Nhạc Lofi Chill H..."
                               Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"
                               FontFamily="Segoe UI, Arial"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <!-- Audio Equalizer Bars (GPU ScaleTransform, NO Layout Invalidations) -->
                    <StackPanel x:Name="CompactEqPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,4,0">
                        <Border Width="3" Height="14" Background="#FFFFFF" CornerRadius="1.5" Margin="1,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CBar1Scale" ScaleY="0.6"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="3" Height="14" Background="#FFFFFF" CornerRadius="1.5" Margin="1,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CBar2Scale" ScaleY="1.0"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="3" Height="14" Background="#FFFFFF" CornerRadius="1.5" Margin="1,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CBar3Scale" ScaleY="0.5"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="3" Height="14" Background="#FFFFFF" CornerRadius="1.5" Margin="1,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CBar4Scale" ScaleY="0.8"/>
                            </Border.RenderTransform>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 4. EXPANDED MEDIA VIEW (Artwork + Title + Artist + Seekbar + Controls) -->
                <Grid x:Name="ExpandedMediaView" Visibility="Collapsed" Opacity="0" Margin="18,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Artwork, Title, Artist, Waveform -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art -->
                        <Border Grid.Column="0" Width="50" Height="50" CornerRadius="10" ClipToBounds="True" Margin="0,0,12,0">
                            <Image x:Name="ExpandedAlbumArt" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Title and Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="ExpandedTitleText" Text="y2mate.com - Nhan Vi Tieng Chuong"
                                       Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                       FontFamily="Segoe UI, Arial"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ExpandedArtistText" Text="Khiem Phan"
                                       Foreground="#8E8E9E" FontSize="12" FontWeight="Normal"
                                       FontFamily="Segoe UI, Arial" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Equalizer wave bars on top right (GPU ScaleTransform) -->
                        <StackPanel x:Name="ExpandedEqPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="20" Background="#A0A0B8" CornerRadius="1.5" Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="EBar1Scale" ScaleY="0.5"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="#A0A0B8" CornerRadius="1.5" Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="EBar2Scale" ScaleY="1.0"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="#A0A0B8" CornerRadius="1.5" Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="EBar3Scale" ScaleY="0.7"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="#A0A0B8" CornerRadius="1.5" Margin="1.5,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5, 1">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="EBar4Scale" ScaleY="0.9"/>
                                </Border.RenderTransform>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Seekbar & Times -->
                    <Grid Grid.Row="1" Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="0:00"
                                   Foreground="#707080" FontSize="11" FontFamily="Segoe UI, Arial"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Slider x:Name="MediaSeekSlider" Grid.Column="1"
                                Style="{StaticResource IslandSliderStyle}"
                                Minimum="0" Maximum="100" Value="0"
                                PreviewMouseDown="MediaSeekSlider_PreviewMouseDown"
                                PreviewMouseUp="MediaSeekSlider_PreviewMouseUp"
                                ValueChanged="MediaSeekSlider_ValueChanged"/>

                        <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="39:00"
                                   Foreground="#707080" FontSize="11" FontFamily="Segoe UI, Arial"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Row 3: Playback Controls (Prev, Play/Pause, Next) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <!-- Prev Button -->
                        <Button Style="{StaticResource MediaButtonStyle}" Width="40" Height="36" Click="PrevBtn_Click" ToolTip="Bài trước">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="White"
                                  Data="M6,6h2v12H6V6z M9.5,12l8.5,6V6L9.5,12z"/>
                        </Button>

                        <!-- Play / Pause Button -->
                        <Button x:Name="PlayPauseButton" Style="{StaticResource MediaButtonStyle}" Width="48" Height="40" Margin="16,0" Click="PlayPauseBtn_Click" ToolTip="Phát / Tạm dừng">
                            <Path x:Name="PlayPausePath" Width="20" Height="20" Stretch="Uniform" Fill="White"
                                  Data="M6,19h4V5H6V19z M14,5v14h4V5H14z"/>
                        </Button>

                        <!-- Next Button -->
                        <Button Style="{StaticResource MediaButtonStyle}" Width="40" Height="36" Click="NextBtn_Click" ToolTip="Bài tiếp">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="White"
                                  Data="M6,18l8.5-6L6,6V18z M16,6v12h2V6H16z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
